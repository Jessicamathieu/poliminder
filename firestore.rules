rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Permet la lecture et l'écriture à tous les utilisateurs authentifiés.
    // ATTENTION : C'est une règle très permissive. Pour la production,
    // vous devriez restreindre l'accès en fonction des rôles ou des UID des utilisateurs.
    match /{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}
