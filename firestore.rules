
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
  
    // Helper function to check if a user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }
    
    // Helper function to get user data from the 'users' collection
    function getUserData(userId) {
      return get(/databases/$(database)/documents/users/$(userId)).data;
    }
    
    // Helper function to check if the user is an admin
    function isAdmin(userId) {
      return getUserData(userId).role == 'admin';
    }

    // USERS
    // - Only authenticated users can read their own data.
    // - Admins can read anyone's data.
    // - No one can write to the users collection directly from the client.
    match /users/{userId} {
      allow read: if isAuthenticated() && (request.auth.uid == userId || isAdmin(request.auth.uid));
      allow write: if false; // Should be managed by backend/admin only
    }

    // CLIENTS
    // - Any authenticated user can read all clients (for now).
    // - Only admins can create, update, or delete clients.
    match /clients/{clientId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated() && isAdmin(request.auth.uid);
    }
    
    // SERVICES
    // - Any authenticated user can read all services.
    // - Only admins can create, update, or delete services.
    match /services/{serviceId} {
       allow read: if isAuthenticated();
       allow write: if isAuthenticated() && isAdmin(request.auth.uid);
    }
    
    // APPOINTMENTS
    // - Any authenticated user can read, create, update, or delete appointments.
    // This could be restricted further (e.g., Mikael can only update status).
    match /appointments/{appointmentId} {
       allow read, write: if isAuthenticated();
    }
    
    // EXPENSES
    // - Any authenticated user can read, create, update, or delete expenses.
    match /expenses/{expenseId} {
        allow read, write: if isAuthenticated();
    }

    // QUICKBOOKS CREDENTIALS
    // - No client-side access is allowed. This must be managed by the backend.
    match /quickbooks_credentials/{docId} {
      allow read, write: if false;
    }
  }
}
